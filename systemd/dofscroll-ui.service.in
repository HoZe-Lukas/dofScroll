[Unit]
Description=SpaceMouse scroll settings window and tray icon, Qt (dofscroll-ui)
After=graphical-session.target dofscroll.service
PartOf=graphical-session.target

[Service]
ExecStart=@DOFSCROLL_BINDIR@/dofscroll-ui
Restart=on-failure

# --- Hardening (user unit, only directives from systemd <= 252 / RHEL 9) --------
# Same sandbox as dofscroll-tray.service (the Qt UI needs neither more nor less: same X11/DBus
# sockets, same writable paths, no MemoryDenyWriteExecute). Not yet tested with the Qt build under
# systemd 252.
# Rationale, test log and deliberately NOT set directives:
# docs/security.md, section 3.
# The Qt UI needs: X11 or Wayland socket (Qt xcb/wayland plugin), DBus session bus
# (StatusNotifier tray icon, systemctl --user, xdg-open portal), write access to
# ~/.config/dofscroll (config, atomic via
# temp+rename) and %t (= /run/user/UID: dconf/at-spi). Child processes
# (systemctl, xdg-open + editor) inherit this sandbox!
# KNOWN LIMIT: The DBus session bus is reachable (required for AppIndicator/systemctl).
# Through it a compromised UI can start a process OUTSIDE this sandbox via
# 'systemd-run --user' (sandbox escape). This hardening limits file system/syscalls,
# but is NOT a boundary against DBus-capable code.
NoNewPrivileges=yes
UMask=0077
# PrivateUsers=yes is MANDATORY in the systemd 252 user manager (otherwise the
# Protect* directives are ignored or the start fails with 218).
PrivateUsers=yes
CapabilityBoundingSet=
# NO PrivateTmp (hides /tmp/.X11-unix).
ProtectSystem=strict
ProtectHome=read-only
# Write access ONLY to the own config directory ~/.config/dofscroll
# (%E = $XDG_CONFIG_HOME or ~/.config) and %t (= /run/user/UID). The rest of
# ~/.config (systemd/user, autostart, environment.d, ...) stays read-only so that
# a compromised UI cannot drop user units/autostart entries/environment
# settings; the earlier ReadOnlyPaths exceptions are therefore unnecessary.
# ConfigurationDirectory= creates the directory (mode 0700) BEFORE the mount
# namespace is set up, otherwise the ReadWritePaths target would not exist on
# first start. Tested 2026-10-15 (systemd 252, user manager): directory
# is created, creating a file + rename inside it works, 'touch ~/.config/zz-test' and
# writing to ~/.config/systemd/user return EROFS.
ConfigurationDirectory=dofscroll
ConfigurationDirectoryMode=0700
ReadWritePaths=%E/dofscroll %t
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
KeyringMode=private
# No PrivateIPC: Qt xcb uses MIT-SHM (SysV shared memory with the X server).
# AF_UNIX: X11 + DBus. AF_NETLINK: Qt/GLib (network monitor, QtNetwork) query
# netlink on demand.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute deliberately NOT set: Qt (QRegularExpression PCRE2 JIT) and possibly
# Mesa/GL need W+X memory.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM
# Tested 2026-10-15 (systemd-run with all directives of this unit + candidate):
# SET: SystemCallFilter=~@resources (effective: setpriority/sched_setaffinity
#   return EPERM; no code path of the binaries uses them, start OK).
# NOT set: ProtectProc=invisible, ProcSubset=pid, IPAddressDeny=any. Startable,
#   but demonstrably ineffective in the user manager (PrivateUsers=yes): foreign PIDs,
#   /proc/sys and 127.0.0.1 remained reachable. They would only give a false
#   sense of security and a cosmetically better 'security' score.

[Install]
WantedBy=graphical-session.target
