[Unit]
Description=SpaceMouse multi-axis scroll and zoom translator (dofscroll)
After=graphical-session.target

[Service]
ExecStart=@DOFSCROLL_EXEC_Q@@DOFSCROLL_EXEC_BINDIR@/dofscroll@DOFSCROLL_EXEC_Q@
# Safeguard after a crash/SIGKILL (XTest keys would otherwise stay pressed, see docs/security.md S3)
ExecStopPost=-@DOFSCROLL_EXEC_Q@@DOFSCROLL_EXEC_BINDIR@/dofscroll@DOFSCROLL_EXEC_Q@ --release-keys
Restart=always
RestartSec=1s
# A second daemon (the lock is held by the first) exits with 75: do not start it again in a loop
RestartPreventExitStatus=75

# --- Hardening (user unit, only directives from systemd <= 252 / RHEL 9) --------
# Rationale, test log and deliberately NOT set directives:
# docs/security.md, section 3.
# The daemon needs: X11 socket /tmp/.X11-unix (XTest), spacenavd socket
# /run/spnav.sock, /dev/uinput (uinput backend), read access to the config
# and possibly kdotool (DBus session bus, AF_UNIX). It may write only in the private
# runtime dir %t (XDG_RUNTIME_DIR): status file dofscroll-status and log copy
# dofscroll.log for the interface (docs/security.md); everything else stays read-only.
# KNOWN LIMIT: AF_UNIX also allows the DBus session bus. Through it, compromised
# code could start a process OUTSIDE this sandbox via 'systemd-run --user'
# (escape). The bus is only needed for the optional kdotool (KDE active window);
# without kdotool AF_UNIX cannot be restricted further (X11/spacenavd are also
# Unix sockets), hence deliberately left open.
NoNewPrivileges=yes
UMask=0077
# PrivateUsers=yes is MANDATORY in the systemd 252 user manager: without it
# ProtectSystem/ProtectHome/ProtectKernelTunables/ProtectControlGroups are
# silently ignored. Supplementary groups (e.g. 'input') appear in it
# as 'nobody', but the kernel's permission check still applies
# (/dev/uinput via the group remains usable).
# NOT set: CapabilityBoundingSet=, ProtectKernelModules=, ProtectKernelLogs=,
# ProtectClock=. With PrivateUsers=yes they start on a system that allows
# unprivileged user namespaces (RHEL 9, systemd 252, verified 2026-10-15), but
# on a distribution that confines them with AppArmor (Ubuntu 24.10+, sysctl
# kernel.apparmor_restrict_unprivileged_userns = 1) the sandbox setup is denied
# CAP_SETPCAP/CAP_SYS_ADMIN and the unit fails with status=218/CAPABILITIES
# BEFORE ExecStart: the daemon never starts (verified 2026-10-25, also with a
# transient unit running /bin/true). Re-enable on a system that allows it:
# systemctl --user edit dofscroll.service (docs/security.md, section 3).
PrivateUsers=yes
# File system: everything read-only, home incl. config (~/.config/dofscroll/
# dofscroll.conf or legacy fallback ~/.config/dofscroll.conf) read-only;
# tested 2026-10-15: both paths readable, --release-keys runs in the sandbox. NO
# PrivateTmp (hides /tmp/.X11-unix) and NO PrivateDevices (hides
# /dev/uinput).
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
PrivateIPC=yes
KeyringMode=private
# Network: Unix sockets only (local X11, spacenavd, DBus for kdotool).
# No PrivateNetwork: it would cut abstract sockets (@/tmp/.X11-unix/X0).
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM
# Tested 2026-10-15 (systemd-run with all directives of this unit + candidate):
# SET: SystemCallFilter=~@resources (effective: setpriority/sched_setaffinity
#   return EPERM; no code path of the binaries uses them, start OK, ExecStopPost
#   variant --release-keys OK).
# NOT set: ProtectProc=invisible, ProcSubset=pid, IPAddressDeny=any. Startable,
#   but demonstrably ineffective in the user manager (PrivateUsers=yes): foreign PIDs,
#   /proc/sys and 127.0.0.1 remained reachable. They would only give a false
#   sense of security and a cosmetically better 'security' score.

[Install]
WantedBy=graphical-session.target
