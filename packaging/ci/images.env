#
# The container images of the CI and release builds, pinned by digest (name@sha256:...), so that a replaced tag
# cannot change what goes into the checks and the RPM, DEB and TGZ packages. They live here and not in the
# workflow files: the workflows read this file in a small first job (`pins`) and pass the values to `container:`.
# That way the monthly refresh (scripts/pin-ci-images.sh, .github/workflows/refresh-ci-pins.yml) changes no
# workflow file and its pull request needs no special token (docs/releasing.md, "Pinned build inputs").
# Plain KEY=VALUE lines, no quotes, no spaces; scripts/check-ci-pins.sh checks them.
ROCKY9_IMAGE=ghcr.io/hoze-lukas/dofscroll-ci-rocky9@sha256:7fe57999a024be4b9d95b6d44bf4a84efb46c28f22063c256afe9e1e862014c1
ROCKY9_QT_IMAGE=ghcr.io/hoze-lukas/dofscroll-ci-rocky9-qt@sha256:f6ed44fa5abf755ad8676f882287ca1d168105432c9f4d25e11f1d8d34729b07
DEBIAN12_IMAGE=debian:12@sha256:854dd8ab51d62866dbd8f5431d15ce77b12983a2a4a1e1fe43a2395dc7ef9f61
