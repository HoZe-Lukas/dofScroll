<!-- Template of the per-user LaunchAgent. install-launchagent.sh replaces the two placeholders
     (the daemon path, written between at-signs below) with an absolute path; launchd does not
     expand "~" or "$HOME". -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.dofscroll.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>@DAEMON_PATH@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but not after a clean exit (e.g. the user quit it). launchd cannot
         tell exit codes apart, so under launchd the daemon exits with 0 on permanent errors
         (missing device descriptions, unusable configuration) and is not restarted in a loop. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- Interactive: the daemon posts input events and must not be throttled as a background job. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <!-- The daemon has its own rolling log (~/Library/Caches/dofscroll/dofscroll.log); launchd's
         capture files would grow without limit. -->
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
