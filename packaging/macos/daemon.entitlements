<!--
  Entitlements of the daemon (build-dmg.sh signs it with the hardened runtime). Only this one:
  the daemon loads the vendor framework /Library/Frameworks/3DconnexionClient.framework at run time
  (src/platform/mac/mac_client_api.hpp, dlopen), which another team signed, and the hardened runtime
  refuses that without library validation being disabled. Deliberately NOT set:
  com.apple.security.cs.allow-dyld-environment-variables, so DYLD_INSERT_LIBRARIES is ignored and
  another process of the user cannot inject code into a process that holds the Accessibility and
  Input Monitoring grants (issue #269). The CI job "macOS DMG" tests that.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
