#
# The ONE place that names the Qt version of every dofscroll build that ships Qt: Linux packages
# (RPM, DEB, TGZ bundle it), Windows installer, macOS disk image, the CI image and the ui jobs.
# Plain KEY=VALUE lines: shell scripts and the Dockerfile `. packaging/qt.env`, workflows append the
# file to $GITHUB_ENV. To bump Qt change QT_VERSION here (docs/release-process.md).
QT_VERSION=6.9.3
# aqtinstall (pip), the tool that downloads Qt from download.qt.io
AQT_VERSION=3.1.19
