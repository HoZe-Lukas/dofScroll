# Package step after the files are installed (RPM %post and DEB postinst, same file). Never fails the
# package transaction (always exit 0), every call is time-limited, nothing in the users' configuration is touched.
# 1. On every install and upgrade: if the system service spacenavd.service exists but is not running, only a
#    message is printed (how to enable it). The package NEVER enables or starts spacenavd itself: an
#    administrator who disabled it on purpose must not get it back, and the setup guide of the interface shows the
#    same command. A fresh install does NOT start the user's dofscroll units either: the interface starts the
#    daemon at the first start (the user opens dofscroll from the application menu).
# 2. Upgrade step 2 of 2: packaging/cpack/preinst stopped the dofscroll user units before the files were
#    replaced: here, for every logged-in user, the daemon and then the interface are started again, whether
#    they were running before or not, so the new binaries are used without a re-login. Only after an
#    UPGRADE (not a fresh install).
# Migration: the old GTK tray (dofscroll-tray.service) was removed. A user who had it enabled
# gets dofscroll-ui.service enabled instead (and started, if the tray was running), so the tray
# icon does not disappear; only systemd user unit links change, never the dofscroll configuration.
#   RPM: $1 = number of installed instances after this one (1 = fresh install, 2+ = upgrade)
#   DEB: $1 = configure, $2 = previous version (empty on a fresh install)

# 1. spacenavd: before the upgrade gate below, so a fresh install gets the message too. Needs a running systemd
# (not a chroot or an image build), `timeout` (every call is time-limited) and an existing unit. Changes nothing.
tell_spacenavd() {
    [ -d /run/systemd/system ] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0
    command -v timeout >/dev/null 2>&1 || return 0
    timeout 20 systemctl cat spacenavd.service >/dev/null 2>&1 || return 0
    timeout 20 systemctl is-active --quiet spacenavd.service >/dev/null 2>&1 && return 0
    echo "dofscroll: the SpaceMouse driver service spacenavd is installed but not running."
    echo "dofscroll: dofscroll cannot see the device until it runs. To start it now and at every boot, run:"
    echo "dofscroll:     sudo systemctl enable --now spacenavd.service"
    return 0
}
case "$1" in
    configure | [0-9]*) tell_spacenavd || true ;;  # RPM: a number; DEB: configure (not abort-upgrade and the like)
esac

# 2. Upgrade only.
case "$1" in
    configure) [ -n "$2" ] || exit 0 ;;
    '' | *[!0-9]*) exit 0 ;;
    *) [ "$1" -ge 2 ] || exit 0 ;;
esac

command -v loginctl >/dev/null 2>&1 || exit 0
command -v systemctl >/dev/null 2>&1 || exit 0
# Every call below is time-limited; without `timeout` a hung user manager could stall the package
# transaction, so nothing is done then (restart by hand, docs/installation.md).
command -v timeout >/dev/null 2>&1 || exit 0

# Runs a command with a time limit; callers ignore failures.
limited() {
    timeout 20 "$@"
}

users=$(limited loginctl list-users --no-legend 2>/dev/null | while read -r _uid name _rest; do
    printf '%s\n' "$name"
done)

# Only when this package ships the Qt UI unit; otherwise the old tray link stays as it is.
ui_unit=/usr/lib/systemd/user/dofscroll-ui.service

# Is the removed dofscroll-tray.service enabled for the user whose home is $1? The unit file is
# gone by now, so look for the enable link itself (a dangling symlink in a .wants directory).
tray_link_in() {
    for l in "$1"/.config/systemd/user/*.wants/dofscroll-tray.service; do
        [ -L "$l" ] && return 0
    done
    return 1
}

migrate_user() {
    m="$1@.host"
    home=$(getent passwd "$1" 2>/dev/null | cut -d: -f6)
    [ -n "$home" ] && [ -d "$home" ] || return 0
    tray_link_in "$home" || return 0
    was_active=0
    limited systemctl --user --machine="$m" is-active --quiet dofscroll-tray.service \
        >/dev/null 2>&1 && was_active=1
    limited systemctl --user --machine="$m" stop dofscroll-tray.service >/dev/null 2>&1 || true
    limited systemctl --user --machine="$m" disable dofscroll-tray.service >/dev/null 2>&1 || true
    # Still there (systemctl cannot disable a unit without a unit file on some versions): remove only the
    # dangling enable links of that one unit. The home directory belongs to the user, so root must not delete in
    # it (a link swapped between the check and the removal could point anywhere): the removal runs as the user.
    if command -v runuser >/dev/null 2>&1; then
        for l in "$home"/.config/systemd/user/*.wants/dofscroll-tray.service; do
            [ -L "$l" ] && [ ! -e "$l" ] && limited runuser -u "$1" -- rm -f -- "$l" >/dev/null 2>&1
        done
    fi
    limited systemctl --user --machine="$m" enable dofscroll-ui.service >/dev/null 2>&1 || true
    if [ "$was_active" = 1 ]; then
        limited systemctl --user --machine="$m" start dofscroll-ui.service >/dev/null 2>&1 || true
    fi
    return 0
}

# System-wide enable (systemctl --global enable dofscroll-tray.service by an administrator).
if [ -f "$ui_unit" ]; then
    for l in /etc/systemd/user/*.wants/dofscroll-tray.service; do
        if [ -L "$l" ]; then
            limited systemctl --global disable dofscroll-tray.service >/dev/null 2>&1 || true
            [ -L "$l" ] && [ ! -e "$l" ] && rm -f "$l" 2>/dev/null
            limited systemctl --global enable dofscroll-ui.service >/dev/null 2>&1 || true
            break
        fi
    done
fi

# A dofscroll-ui that the unit did not start (the desktop's session restore did) is not touched by
# try-restart: the unit is inactive and the old process would keep running the replaced binary. Stop
# such a process of that user (only one whose executable was replaced) and start the unit again.
restart_stale_ui() {
    m="$1@.host"
    [ -f "$ui_unit" ] || return 0
    command -v pgrep >/dev/null 2>&1 || return 0
    uid=$(id -u "$1" 2>/dev/null) || return 0
    [ -n "$uid" ] || return 0
    limited systemctl --user --machine="$m" is-active --quiet dofscroll-ui.service >/dev/null 2>&1 && return 0
    # Only a user who has the unit enabled gets the interface back; for anyone else a stopped interface
    # would stay gone, so it is left running (old program) instead.
    limited systemctl --user --machine="$m" is-enabled --quiet dofscroll-ui.service >/dev/null 2>&1 || return 0
    found=0
    for pid in $(limited pgrep -u "$uid" -x dofscroll-ui 2>/dev/null); do
        case "$(readlink "/proc/$pid/exe" 2>/dev/null)" in
            *"(deleted)")
                # the process may have exited and its number been reused since the list was taken: it must
                # still belong to that user right before the signal
                [ "$(awk '/^Uid:/ { print $2; exit }' "/proc/$pid/status" 2>/dev/null)" = "$uid" ] || continue
                kill -TERM "$pid" 2>/dev/null && found=1 ;;
        esac
    done
    [ "$found" = 1 ] || return 0
    sleep 1
    limited systemctl --user --machine="$m" start dofscroll-ui.service >/dev/null 2>&1 || true
    return 0
}

for name in $users; do
    case "$name" in
        '' | -* | *[!A-Za-z0-9._@-]*) continue ;;
    esac
    m="$name@.host"
    limited systemctl --user --machine="$m" daemon-reload >/dev/null 2>&1 || true
    if [ -f "$ui_unit" ]; then migrate_user "$name" || true; fi
    # an interface that the desktop's session restore started would keep the new one from starting (single
    # instance): it is stopped first (only when its binary was replaced and the user has the unit enabled)
    restart_stale_ui "$name" || true
    # always started, also when the units were not running before the upgrade: the daemon first
    limited systemctl --user --machine="$m" start dofscroll.service >/dev/null 2>&1 || true
    if [ -f "$ui_unit" ]; then
        limited systemctl --user --machine="$m" start dofscroll-ui.service >/dev/null 2>&1 || true
    fi
done
exit 0
