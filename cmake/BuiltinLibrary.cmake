#
# Embeds examples/modes/*.conf (joystick modes) and examples/buttons/*.conf (button modes) into the
# core library as byte arrays, so the built-in mode library needs no files at run time. The example
# files stay the single source of truth. Bytes are emitted as numbers (no string literals), which
# avoids the MSVC limit on string literal length and any escaping problem.
#
#   dofscroll_generate_builtin_library(<output .cpp>)
#
# The file name without ".conf" is the id; for the legacy list the id is the part before the first dot,
# so "timeline.2.conf" is a second text of the id "timeline" (the symbols carry a running number). The output is only rewritten when its content changes,
# and CMake re-runs when one of the sources changes (CMAKE_CONFIGURE_DEPENDS).

function(dofscroll_embed_dir kind dir outVar)
  file(GLOB confs CONFIGURE_DEPENDS ${dir}/*.conf)
  list(SORT confs)
  set(entries "")
  set(n 0)
  foreach(f ${confs})
    get_filename_component(id ${f} NAME_WE)
    file(READ ${f} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    math(EXPR n "${n} + 1")
    string(MAKE_C_IDENTIFIER "${kind}_${id}_${n}" sym)
    string(APPEND entries "const unsigned char ${sym}[] = {${bytes}0x00};\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${f})
  endforeach()
  string(APPEND entries "const BuiltinFile ${kind}_files[] = {\n")
  set(n 0)
  foreach(f ${confs})
    get_filename_component(id ${f} NAME_WE)
    math(EXPR n "${n} + 1")
    string(MAKE_C_IDENTIFIER "${kind}_${id}_${n}" sym)
    string(APPEND entries "    {\"${id}\", reinterpret_cast<const char *>(${sym})},\n")
  endforeach()
  string(APPEND entries "    {nullptr, nullptr}};\n")
  set(${outVar} "${entries}" PARENT_SCOPE)
endfunction()

function(dofscroll_generate_builtin_library output)
  dofscroll_embed_dir(modes ${CMAKE_SOURCE_DIR}/examples/modes modeEntries)
  dofscroll_embed_dir(buttons ${CMAKE_SOURCE_DIR}/examples/buttons buttonEntries)
  # Texts of the files the first-start seeding of earlier versions copied (examples/legacy/modes):
  # a user file identical to one of them is the shipped example, not the user's own work.
  dofscroll_embed_dir(legacy ${CMAKE_SOURCE_DIR}/examples/legacy/modes legacyEntries)
  set(content "// Generated by cmake/BuiltinLibrary.cmake from examples/modes and examples/buttons. Do not edit.\n")
  string(APPEND content "#include \"builtin_library.hpp\"\n\nnamespace spn {\nnamespace {\n")
  string(APPEND content "${modeEntries}${buttonEntries}${legacyEntries}")
  string(APPEND content "}  // namespace\n\n")
  string(APPEND content "const BuiltinFile *builtinModeFiles() { return modes_files; }\n")
  string(APPEND content "const BuiltinFile *builtinButtonModeFiles() { return buttons_files; }\n")
  string(APPEND content "const BuiltinFile *legacyModeFiles() { return legacy_files; }\n")
  string(APPEND content "\n}  // namespace spn\n")
  set(old "")
  if(EXISTS ${output})
    file(READ ${output} old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE ${output} "${content}")
  endif()
endfunction()
