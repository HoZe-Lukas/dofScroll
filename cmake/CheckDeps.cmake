# Script mode: cmake [-DWITH_TRAY=OFF] [-DCXX=c++] -P cmake/CheckDeps.cmake
# Reports missing build dependencies and prints the package install lines.
if(NOT DEFINED WITH_TRAY)
  set(WITH_TRAY ON)
endif()
if(NOT CXX)
  set(CXX c++)
endif()
find_program(PKGCONF NAMES pkg-config pkgconf)
set(miss 0)
set(mods x11 xtst)
if(WITH_TRAY)
  list(APPEND mods gtk+-3.0 appindicator3-0.1)
endif()
foreach(p ${mods})
  set(found FALSE)
  if(PKGCONF)
    execute_process(COMMAND ${PKGCONF} --exists ${p} RESULT_VARIABLE rc
                    OUTPUT_QUIET ERROR_QUIET)
    if(rc EQUAL 0)
      set(found TRUE)
    endif()
  endif()
  if(found)
    message("ok      ${p}")
  else()
    message("MISSING ${p}")
    set(miss 1)
  endif()
endforeach()
if(NOT PKGCONF)
  message("MISSING pkg-config")
endif()
file(WRITE "${CMAKE_CURRENT_LIST_DIR}/.deps_probe.cpp" "#include <spnav.h>\nint main(){}\n")
execute_process(COMMAND ${CXX} -fsyntax-only "${CMAKE_CURRENT_LIST_DIR}/.deps_probe.cpp"
                RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
file(REMOVE "${CMAKE_CURRENT_LIST_DIR}/.deps_probe.cpp")
if(rc EQUAL 0)
  message("ok      libspnav (spnav.h)")
else()
  message("MISSING libspnav (spnav.h)")
  set(miss 1)
endif()
if(miss OR NOT PKGCONF)
  message("\nInstall the missing packages:")
  message("  RHEL 9 + EPEL:")
  message("    sudo dnf install -y epel-release")
  message("    sudo dnf install -y gcc-c++ cmake pkgconf-pkg-config spacenavd libspnav-devel \\")
  message("        libX11-devel libXtst-devel gtk3-devel libappindicator-gtk3-devel")
  message("  Debian/Ubuntu:")
  message("    sudo apt install g++ cmake pkg-config libspnav-dev libx11-dev libxtst-dev \\")
  message("        libgtk-3-dev libayatana-appindicator3-dev")
  message("(GTK/appindicator only for the tray; configure with -DDOFSCROLL_TRAY=OFF to skip it.)")
  message(FATAL_ERROR "Dependencies missing.")
endif()
message("All dependencies present.")
