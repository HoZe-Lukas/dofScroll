# ctest script: cmake -DBUILD_DIR=<build> -DSRC=<repo> -DTMP=<scratch> -P cmake/PackageLayoutTest.cmake
# Builds the CPack TGZ and fails if any packaged text file contains a staging, build or
# source path (regression test for units that pointed into _CPack_Packages).
file(REMOVE_RECURSE "${TMP}")
file(MAKE_DIRECTORY "${TMP}/out" "${TMP}/x")
execute_process(COMMAND ${CMAKE_CPACK_COMMAND} -G TGZ --config ${BUILD_DIR}/CPackConfig.cmake
                        -B ${TMP}/out
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
if(rc)
  message(FATAL_ERROR "cpack failed:\n${out}")
endif()
file(GLOB tgz "${TMP}/out/dofscroll-*.tar.gz")
list(LENGTH tgz n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "expected one TGZ, found: ${tgz}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E tar xzf ${tgz} WORKING_DIRECTORY ${TMP}/x
                RESULT_VARIABLE rc)
if(rc)
  message(FATAL_ERROR "extracting ${tgz} failed")
endif()
file(GLOB_RECURSE files "${TMP}/x/*")
set(forbidden "_CPack_Packages" "/__w/" "${SRC}" "${BUILD_DIR}")
set(scanned 0)
foreach(f ${files})
  # Binaries may legitimately embed __FILE__ paths; the install layout is what matters.
  if(f MATCHES "/bin/")
    continue()
  endif()
  file(READ "${f}" c)
  math(EXPR scanned "${scanned}+1")
  foreach(bad ${forbidden})
    string(FIND "${c}" "${bad}" pos)
    if(NOT pos EQUAL -1)
      message(FATAL_ERROR "packaged file ${f} contains '${bad}'")
    endif()
  endforeach()
endforeach()
file(GLOB_RECURSE units "${TMP}/x/*/usr/lib/systemd/user/*.service")
if(NOT units)
  message(FATAL_ERROR "no systemd units found in the package")
endif()
foreach(u ${units})
  get_filename_component(n "${u}" NAME_WE)
  file(READ "${u}" c)
  if(NOT c MATCHES "ExecStart=/usr/bin/${n}\n")
    message(FATAL_ERROR "${u}: ExecStart is not /usr/bin/${n}")
  endif()
endforeach()
if(EXISTS "${TMP}/x" )
  file(GLOB_RECURSE rules "${TMP}/x/*/usr/lib/udev/*")
  if(rules)
    message(FATAL_ERROR "package ships an active udev rule: ${rules}")
  endif()
endif()
message(STATUS "package_layout OK (${scanned} files scanned)")
