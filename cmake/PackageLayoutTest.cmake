# ctest script: cmake -DBUILD_DIR=<build> -DSRC=<repo> -DTMP=<scratch> -P cmake/PackageLayoutTest.cmake
# Builds the CPack TGZ and fails if any packaged text file contains a staging, build or
# source path (regression test for units that pointed into _CPack_Packages).
file(REMOVE_RECURSE "${TMP}")
file(MAKE_DIRECTORY "${TMP}/out" "${TMP}/x")
execute_process(COMMAND ${CMAKE_CPACK_COMMAND} -G TGZ --config ${BUILD_DIR}/CPackConfig.cmake
                        -B ${TMP}/out
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
if(rc)
  message(FATAL_ERROR "cpack failed:\n${out}")
endif()
file(GLOB tgz "${TMP}/out/dofscroll-*.tar.gz")
list(LENGTH tgz n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "expected one TGZ, found: ${tgz}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E tar xzf ${tgz} WORKING_DIRECTORY ${TMP}/x
                RESULT_VARIABLE rc)
if(rc)
  message(FATAL_ERROR "extracting ${tgz} failed")
endif()
file(GLOB_RECURSE files "${TMP}/x/*")
set(forbidden "_CPack_Packages" "/__w/" "${SRC}" "${BUILD_DIR}")
set(scanned 0)
foreach(f ${files})
  # Binaries may legitimately embed __FILE__ paths; the install layout is what matters.
  if(f MATCHES "/bin/")
    continue()
  endif()
  file(READ "${f}" c)
  math(EXPR scanned "${scanned}+1")
  foreach(bad ${forbidden})
    string(FIND "${c}" "${bad}" pos)
    if(NOT pos EQUAL -1)
      message(FATAL_ERROR "packaged file ${f} contains '${bad}'")
    endif()
  endforeach()
endforeach()
file(GLOB_RECURSE units "${TMP}/x/*/usr/lib/systemd/user/*.service")
if(NOT units)
  message(FATAL_ERROR "no systemd units found in the package")
endif()
foreach(u ${units})
  get_filename_component(n "${u}" NAME_WE)
  file(READ "${u}" c)
  if(NOT c MATCHES "ExecStart=/usr/bin/${n}\n")
    message(FATAL_ERROR "${u}: ExecStart is not /usr/bin/${n}")
  endif()
endforeach()
# The GTK tray is gone: no package may contain its program, unit or icon directory.
file(GLOB_RECURSE old_tray "${TMP}/x/*/dofscroll-tray" "${TMP}/x/*/dofscroll-tray.service" "${TMP}/x/*/dofscroll-tray/*")
if(old_tray)
  message(FATAL_ERROR "package contains the removed GTK tray: ${old_tray}")
endif()
# Qt UI (only when the build found Qt6): program, menu entry, icon and unit.
file(GLOB_RECURSE ui_unit "${TMP}/x/*/usr/lib/systemd/user/dofscroll-ui.service")
file(GLOB_RECURSE ui_bin "${TMP}/x/*/usr/bin/dofscroll-ui")
if(ui_unit OR ui_bin)
  file(GLOB_RECURSE desktop "${TMP}/x/*/usr/share/applications/dofscroll.desktop")
  file(GLOB_RECURSE icon "${TMP}/x/*/usr/share/icons/hicolor/scalable/apps/dofscroll.svg")
  foreach(need ui_unit ui_bin desktop icon)
    if(NOT ${need})
      message(FATAL_ERROR "Qt UI package is incomplete: missing ${need}")
    endif()
  endforeach()
  file(READ "${ui_unit}" c)
  if(c MATCHES "dofscroll-tray")
    message(FATAL_ERROR "dofscroll-ui.service must not mention the removed dofscroll-tray.service")
  endif()
  # The UI pulls in the daemon (issue: starting only the UI must start the daemon too).
  if(NOT c MATCHES "\nWants=dofscroll\\.service\n")
    message(FATAL_ERROR "dofscroll-ui.service must have Wants=dofscroll.service")
  endif()
  if(NOT c MATCHES "\nAfter=[^\n]*dofscroll\\.service")
    message(FATAL_ERROR "dofscroll-ui.service must be ordered After=dofscroll.service")
  endif()
  # The single-instance lock lives in $XDG_RUNTIME_DIR (%t); the unit must keep it writable.
  if(NOT c MATCHES "\nReadWritePaths=[^\n]*%t")
    message(FATAL_ERROR "dofscroll-ui.service: ReadWritePaths must include %t (instance lock)")
  endif()
  file(READ "${desktop}" c)
  foreach(key "Exec=dofscroll-ui\n" "Icon=dofscroll\n" "Categories=Settings;HardwareSettings;\n")
    string(FIND "${c}" "${key}" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "dofscroll.desktop lacks ${key}")
    endif()
  endforeach()
  find_program(DESKTOP_FILE_VALIDATE desktop-file-validate)
  if(DESKTOP_FILE_VALIDATE)
    execute_process(COMMAND ${DESKTOP_FILE_VALIDATE} "${desktop}" RESULT_VARIABLE rc
                    OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(rc)
      message(FATAL_ERROR "desktop-file-validate failed:\n${out}")
    endif()
  endif()
  message(STATUS "package_layout: Qt UI files present")
else()
  message(STATUS "package_layout: package has only the daemon (no Qt UI in this build)")
endif()
# The template is checked even in a build without Qt.
file(READ "${SRC}/systemd/dofscroll-ui.service.in" ui_tpl)
if(NOT ui_tpl MATCHES "\nWants=dofscroll\\.service\n")
  message(FATAL_ERROR "dofscroll-ui.service.in must have Wants=dofscroll.service")
endif()
# Upgrade scriptlet (RPM %post / DEB postinst): wired into CPack, upgrade-only, never fails, no config access.
file(READ "${BUILD_DIR}/CPackConfig.cmake" cpack_cfg)
foreach(key "CPACK_RPM_PRE_INSTALL_SCRIPT_FILE" "CPACK_RPM_POST_INSTALL_SCRIPT_FILE" "CPACK_RPM_PRE_UNINSTALL_SCRIPT_FILE" "CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA")
  string(FIND "${cpack_cfg}" "${key}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "CPack config lacks ${key} (upgrade scriptlet)")
  endif()
endforeach()
# preinst: stops the units before the files are replaced; postinst starts them again; neither fails.
file(READ "${SRC}/packaging/cpack/preinst" pre)
if(NOT pre MATCHES "^#!/bin/sh\n")
  message(FATAL_ERROR "preinst must be a POSIX sh script")
endif()
foreach(need "upgrade) ;;" "-ge 2" "stop dofscroll-ui.service" "stop dofscroll.service" "--machine=" "timeout 30")
  string(FIND "${pre}" "${need}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "preinst lacks '${need}'")
  endif()
endforeach()
if(pre MATCHES "set -[a-z]*e" OR pre MATCHES "\nexit [1-9]" OR NOT pre MATCHES "\nexit 0\n$")
  message(FATAL_ERROR "preinst must never fail the package transaction and must end with exit 0")
endif()
if(pre MATCHES "dofscroll\\.conf" OR pre MATCHES "\\.config/dofscroll")
  message(FATAL_ERROR "preinst must not touch the user's configuration")
endif()
file(READ "${SRC}/packaging/cpack/postinst" post)
if(NOT post MATCHES "^#!/bin/sh\n")
  message(FATAL_ERROR "postinst must be a POSIX sh script")
endif()
foreach(need "configure) [ -n \"$2\" ] || exit 0" "-ge 2" "start dofscroll.service" "start dofscroll-ui.service" "disable dofscroll-tray.service" "enable dofscroll-ui.service" "daemon-reload" "--machine=" "timeout 20" "tell_spacenavd" "sudo systemctl enable --now spacenavd.service" "systemctl cat spacenavd.service" "systemctl is-active --quiet spacenavd.service" "runuser -u")
  string(FIND "${post}" "${need}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "postinst lacks '${need}'")
  endif()
endforeach()
if(post MATCHES "set -[a-z]*e" OR post MATCHES "\nexit [1-9]")
  message(FATAL_ERROR "postinst must never fail the package transaction")
endif()
if(NOT post MATCHES "\nexit 0\n$")
  message(FATAL_ERROR "postinst must end with exit 0")
endif()
# spacenavd: the postinst only prints a message (before the upgrade gate, so a fresh install gets it too); it never
# enables or starts the service. The only "enable --now spacenavd" is inside the text of the message.
string(FIND "${post}" "tell_spacenavd ||" spn_call)
string(FIND "${post}" "configure) [ -n \"$2\" ] || exit 0" gate_pos)
if(spn_call EQUAL -1 OR gate_pos EQUAL -1 OR NOT spn_call LESS gate_pos)
  message(FATAL_ERROR "postinst must tell about spacenavd before the upgrade-only part")
endif()
string(REGEX REPLACE "[^\n]*echo [^\n]*" "" post_code "${post}")
if(post_code MATCHES "systemctl (enable|start|restart)[^\n]*spacenavd" OR post_code MATCHES "enable --now")
  message(FATAL_ERROR "postinst must never enable or start spacenavd")
endif()
# root must not delete inside a home directory: the removal of a dangling link runs as the user
if(post MATCHES "\n[ ]*\\[ -L[^\n]*&& rm -f[^\n]*home")
  message(FATAL_ERROR "postinst must not rm in a user's home as root (use runuser -u)")
endif()
# prerm: removal only, never the configuration
file(READ "${SRC}/packaging/cpack/prerm" prerm)
if(NOT prerm MATCHES "^#!/bin/sh\n")
  message(FATAL_ERROR "prerm must be a POSIX sh script")
endif()
foreach(need "remove | 0) ;;" "stop \"$unit\"" "disable \"$unit\"" "--machine=" "timeout 30")
  string(FIND "${prerm}" "${need}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "prerm lacks '${need}'")
  endif()
endforeach()
if(prerm MATCHES "set -[a-z]*e" OR prerm MATCHES "\nexit [1-9]" OR NOT prerm MATCHES "\nexit 0\n$"
   OR prerm MATCHES "dofscroll\\.conf" OR prerm MATCHES "\\.config/dofscroll" OR prerm MATCHES "spacenavd")
  message(FATAL_ERROR "prerm must never fail, never touch the configuration and never touch spacenavd")
endif()
if(post MATCHES "systemctl --user[^\n]*spacenavd")
  message(FATAL_ERROR "spacenavd is a system service: postinst must not use --user for it")
endif()
# Only systemd unit links of the removed tray unit may be touched (under ~/.config/systemd/user),
# never the dofscroll configuration directory.
if(post MATCHES "dofscroll\\.conf" OR post MATCHES "\\.config/dofscroll")
  message(FATAL_ERROR "postinst must not touch the user's configuration")
endif()
if(EXISTS "${TMP}/x" )
  file(GLOB_RECURSE rules "${TMP}/x/*/usr/lib/udev/*")
  if(rules)
    message(FATAL_ERROR "package ships an active udev rule: ${rules}")
  endif()
endif()
message(STATUS "package_layout OK (${scanned} files scanned)")
