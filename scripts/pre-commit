#!/bin/sh
# Git-Pre-commit-Hook fuer dofscroll (POSIX sh).
#
# Installation: scripts/install-hooks.sh (verlinkt .git/hooks/pre-commit hierher).
# Ablauf:
#   1. Einfacher Secret-Scan ueber die GESTAGTEN Aenderungen (git diff --cached,
#      nur hinzugefuegte Zeilen): private Schluessel, GitLab/GitHub/Slack-Tokens,
#      AWS-Keys, JWTs, password/secret/token/api_key mit '=' oder ':' (auch JSON)
#      -> Abbruch. Zusaetzlich gitleaks, falls installiert.
#   2. "make check-fast", falls das Makefile-Ziel existiert, sonst "make test".
#      Hinweis: make prueft den Arbeitsbaum, nicht exakt den Index - nicht
#      gestagte Aenderungen fliessen also mit ein.
# Umgehung (nur bewusst!): git commit --no-verify
#
# Die Muster sind so geschrieben ([Y], [d] ...), dass dieses Skript sich beim
# Committen nicht selbst als Treffer meldet.

set -u

top=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "pre-commit: nicht in einem Git-Repository" >&2
  exit 1
}
cd "$top" || exit 1

# ------------------------------------------------------------ 1. Secret-Scan
# Nur hinzugefuegte Zeilen. Dateikoepfe werden ueber den Zustand erkannt (Kopf endet
# beim ersten '@@'), NICHT ueber das Zeilenpraefix: eine hinzugefuegte Zeile mit dem
# Inhalt '++ x' erscheint als '+++ x' und darf nicht als Kopf uebersprungen werden.
# --no-prefix: Dateiname ohne 'a/'/'b/'.
added=$(git diff --cached --no-color --no-ext-diff --no-prefix -U0 --diff-filter=ACMR 2>/dev/null |
  awk '
    /^diff --git /      { hdr = 1; next }
    hdr && /^\+\+\+ /   { f = substr($0, 5); next }
    /^@@/               { hdr = 0; next }
    !hdr && /^\+/       { print f ":" substr($0, 2) }
  ')

hits=""
check() {
  # $1 = Beschreibung, $2 = grep -E Muster, $3 = optionale grep-Flags (z.B. -i)
  m=$(printf '%s\n' "$added" | grep -E ${3:-} -- "$2" | cut -c1-160)
  if [ -n "$m" ]; then
    hits="${hits}
--- $1:
$m"
  fi
}

if command -v gitleaks >/dev/null 2>&1; then
  # gitleaks vorhanden: gruendlicher Scan der gestagten Aenderungen (v8.19+: 'git --staged',
  # aeltere: 'protect --staged'); Fehlschlag des Tools selbst bricht nicht ab.
  if gitleaks git --staged --no-banner --redact >/dev/null 2>&1; then :
  else
    rc=$?
    case $rc in
      1) hits="${hits}
--- gitleaks: Fund (Details: gitleaks git --staged -v)" ;;
      *) gitleaks protect --staged --no-banner --redact >/dev/null 2>&1 || {
           [ $? -eq 1 ] && hits="${hits}
--- gitleaks: Fund (Details: gitleaks protect --staged -v)"; } ;;
    esac
  fi
fi

if [ -n "$added" ]; then
  # Schluessel in Ausdruecken wie [Y]/[d]/[t] zerlegt, damit dieses Skript sich nicht selbst trifft.
  check "Privater Schluessel"   '-----BEGIN ([A-Z0-9]+ )*PRIVATE KE[Y]'
  check "GitLab-Token (glpat)"  'glpa[t]-[A-Za-z0-9_-]{20,}'
  check "GitHub-Token (ghp_)"   'gh[pousr]_[A-Za-z0-9]{30,}'
  check "Slack-Token"           'xo[x][baprs]-[A-Za-z0-9-]{10,}'
  check "AWS-Access-Key"        '(AKI[A]|ASI[A])[0-9A-Z]{16}'
  check "JWT"                   'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]+'
  # Zuweisung mit '=' oder ':' (auch JSON "key": "wert"); Platzhalter/Variablen ausgenommen
  check "Geheimnis-Zuweisung"   '(passwor[d]|passw[d]|secre[t]|toke[n]|api[_-]?ke[y])["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_.~-]{8,}' -i
fi

if [ -n "$hits" ]; then
  echo "pre-commit: ABBRUCH - moegliche Geheimnisse in den gestagten Aenderungen:" >&2
  printf '%s\n' "$hits" >&2
  echo "" >&2
  echo "Bitte entfernen (git restore --staged <datei> bzw. Datei bereinigen)." >&2
  echo "Falls sicher ein Fehlalarm: bewusst mit 'git commit --no-verify' umgehen." >&2
  exit 1
fi

# ------------------------------------------------------------ 2. Build/Tests
if [ ! -f Makefile ]; then
  echo "pre-commit: kein Makefile im Repo-Root - Checks uebersprungen" >&2
  exit 0
fi
if ! command -v make >/dev/null 2>&1; then
  echo "pre-commit: 'make' nicht gefunden - Abbruch (Umgehung: git commit --no-verify)" >&2
  exit 1
fi

# Ziel-Erkennung ohne etwas auszufuehren: 'make -qp' gibt nur die Datenbank aus
# (make -n wuerde Rezeptzeilen mit $(MAKE) trotzdem ausfuehren).
if make -qp 2>/dev/null | grep -q '^check-fast:'; then
  target=check-fast
else
  target=test
fi

echo "pre-commit: make $target ..."
if ! make --no-print-directory "$target"; then
  echo "" >&2
  echo "pre-commit: ABBRUCH - 'make $target' fehlgeschlagen." >&2
  echo "Fehler beheben oder (nur bewusst) 'git commit --no-verify'." >&2
  exit 1
fi
exit 0
