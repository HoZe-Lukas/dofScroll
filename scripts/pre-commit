#!/bin/sh
# Git pre-commit hook for dofscroll (POSIX sh).
#
# Installation: scripts/install-hooks.sh (links .git/hooks/pre-commit to this file).
# Flow:
#   1. scripts/secret-scan.sh over the STAGED changes (added lines only): private keys, GitLab/GitHub/Slack tokens,
#      AWS keys, JWTs, password/secret/token/api_key with '=' or ':' (also JSON)
#      -> abort. Additionally gitleaks, if installed.
#   2. CMake target check-fast (-Werror build + tests).
#      Note: this checks the working tree, not exactly the index - unstaged
#      changes are therefore included.
# Bypass (deliberately only!): git commit --no-verify
#
# The patterns are written ([Y], [d] ...) so that this script does not
# flag itself as a match when committed.

set -u

top=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "pre-commit: not in a Git repository" >&2
  exit 1
}
cd "$top" || exit 1

# ------------------------------------------------------------ 1. Secret scan
if ! sh scripts/secret-scan.sh --cached; then
  echo "" >&2
  echo "pre-commit: ABORT - possible secrets in the staged changes." >&2
  echo "Please remove them (git restore --staged <file> or clean up the file)." >&2
  echo "If it is certainly a false positive: deliberately bypass with 'git commit --no-verify'." >&2
  exit 1
fi

if command -v gitleaks >/dev/null 2>&1; then
  # gitleaks present: more thorough scan of the staged changes (v8.19+: 'git --staged',
  # older: 'protect --staged'); a failure of the tool itself does not abort.
  if gitleaks git --staged --no-banner --redact >/dev/null 2>&1; then :
  else
    rc=$?
    case $rc in
      1) echo "pre-commit: ABORT - gitleaks finding (details: gitleaks git --staged -v)" >&2; exit 1 ;;
      *) gitleaks protect --staged --no-banner --redact >/dev/null 2>&1 || {
           [ $? -eq 1 ] && { echo "pre-commit: ABORT - gitleaks finding (details: gitleaks protect --staged -v)" >&2; exit 1; }; } ;;
    esac
  fi
fi

# ------------------------------------------------------------ 2. Build/tests
if [ ! -f CMakeLists.txt ]; then
  echo "pre-commit: no CMakeLists.txt in the repo root - checks skipped" >&2
  exit 0
fi
cmake=$(command -v cmake || true)
if [ -z "$cmake" ] && [ -x "$HOME/.local/bin/cmake" ]; then cmake="$HOME/.local/bin/cmake"; fi
if [ -z "$cmake" ]; then
  echo "pre-commit: 'cmake' not found (pip install --user cmake) - abort (bypass: git commit --no-verify)" >&2
  exit 1
fi

# check-fast builds with -Werror in <build>/check-werror and runs all tests; the
# build directory itself only hosts the target.
bdir=build-hook
echo "pre-commit: cmake check-fast ..."
if ! "$cmake" -S . -B "$bdir" >/dev/null || \
   ! "$cmake" --build "$bdir" --target check-fast; then
  echo "" >&2
  echo "pre-commit: ABORT - 'check-fast' failed." >&2
  echo "Fix the error or (deliberately only) 'git commit --no-verify'." >&2
  exit 1
fi
exit 0
